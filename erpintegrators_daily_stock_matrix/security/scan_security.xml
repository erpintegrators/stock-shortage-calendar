<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="shortage_scan_rule" model="ir.rule">
        <field name="name">Private warehouse scan scope</field><field name="model_id" ref="model_erpintegrators_shortage_scan"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids), ('warehouse_id', 'any', [('id', '>', 0)])]</field>
    </record>
    <record id="shortage_scan_line_rule" model="ir.rule">
        <field name="name">Readable scan shortage</field><field name="model_id" ref="model_erpintegrators_shortage_scan_line"/>
        <field name="domain_force">[('run_id', 'any', [('id', '>', 0)]), ('product_id', 'any', [('active', '=', True)])]</field>
    </record>
</odoo>
